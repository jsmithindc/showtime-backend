#!/bin/bash
set -e

cd "$(dirname "$0")"

if [ ! -d "node_modules" ]; then
  echo "Installing dependencies..."
  npm install
fi

export SERPAPI_KEY="paste-your-real-key-here"
export SCRAPEDO_TOKEN="paste-your-real-token-here"
# Optional second provider for Regal pricing -- if set, Regal calls
# automatically fall over to ZenRows once Scrape.do's quota is
# exhausted, instead of failing outright.
export ZENROWS_API_KEY="paste-your-real-key-here"
# Third fallback for Regal pricing -- Apify's Super Scraper API actor.
# Get your token from Apify Console -> Integrations, not the actor page.
export APIFY_API_TOKEN="paste-your-real-key-here"
# Fourth/last fallback for Regal pricing -- tried only after the other
# three are unconfigured/exhausted. UNCONFIRMED whether it can get
# through Regal's Cloudflare protection; see the long comment in
# lib/proxyProviders/firecrawl.js.
export FIRECRAWL_API_KEY="paste-your-real-key-here"
# Fifth fallback for Regal pricing -- requires BOTH values. Requires
# payment info on file to create the zone (unlike every other provider
# here), so this is opt-in.
export BRIGHTDATA_API_KEY="paste-your-real-key-here"
export BRIGHTDATA_ZONE="paste-your-zone-name-here"
export AMC_VENDOR_KEY="paste-your-real-key-here"
# Fallback theater discovery when Overpass returns 0 results (common from
# hosted/datacenter IPs). Free tier: 3000 calls/day, no billing.
# Sign up at myprojects.geoapify.com to get a key.
export GEOAPIFY_API_KEY="paste-your-real-key-here"
# Movie ratings: IMDb, Rotten Tomatoes and Metacritic in ONE lookup. None of the
# three has a free public API of its own, and OMDb aggregates all of them.
# Free tier: 1000 requests/day, and results are cached 12h with per-title
# dedup, so a normal day uses a tiny fraction of that.
# Get a free key at omdbapi.com/apikey.aspx (email confirmation required).
# Optional -- with this unset, ratings are simply omitted and nothing breaks.
export OMDB_API_KEY="paste-your-real-key-here"
# Marcus Theatres pricing token (Bearer JWT, role CINEMAAPP, email website@injin.com).
# Capture from ticketing.marcustheatres.com DevTools → Network → any /cms/v2/ request's
# Authorization header. Token appears long-lived despite 30-min exp claim.
export MARCUS_TOKEN="paste-your-real-token-here"
# Self-hosted Camofox browser automation server, exposed via Cloudflare Tunnel.
# Used for Atom ticket pricing on Regal theaters (fetches atomtickets.com with
# full JS rendering). Both values required; userId/sessionKey are arbitrary
# shared secrets you pick -- Camofox uses them to namespace browser sessions.
export CAMOFOX_URL="https://camofox.yourdomain.com"
export CAMOFOX_USER_ID="paste-your-chosen-user-id-here"
export CAMOFOX_SESSION_KEY="paste-your-chosen-session-key-here"
export DISABLE_REGAL_PRICING="false"  # set to "true" to pause Regal/Scrape.do pricing again
export DISABLE_CINEMARK_PRICING="false"  # set to "true" to pause Cinemark direct pricing
# Cinema West (Country Club Cinema) fetches its own access token live --
# no manual setup needed here anymore.
# Uncomment and set a real password before exposing this beyond localhost
# (e.g. via Railway, or a Cloudflare Tunnel) to share with friends. Leave
# commented out for normal local-only use -- no login prompt when unset.
# export APP_PASSWORD="pick-something-only-your-friends-know"

echo "Starting Showtime Finder on http://localhost:${PORT:-3000}"
node server.js

# --- SETUP ---
# This is a template, safe to commit -- it has no real secrets in it.
# To actually run this app locally:
#   cp start.sh.example start.sh
#   (edit start.sh, paste in real values)
#   chmod +x start.sh
#   ./start.sh
# start.sh itself is gitignored, so your real keys never get committed.
