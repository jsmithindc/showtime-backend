# This app reads env vars directly from the shell/host (no dotenv
# dependency), so this file is documentation only -- it is NOT loaded
# automatically. For local dev, copy start.sh.example to start.sh and
# fill in real values there. For Railway, add each of these as a
# variable in the project's dashboard (Settings -> Variables); Railway
# injects them into process.env at runtime, no file needed.

# Required
SERPAPI_KEY=
SCRAPEDO_TOKEN=
AMC_VENDOR_KEY=

# Optional -- Regal pricing automatically falls over to ZenRows once
# Scrape.do's quota is exhausted, instead of failing outright, when set.
ZENROWS_API_KEY=

# Optional -- third fallback for Regal pricing, tried after Scrape.do
# and ZenRows. Uses the Super Scraper API actor's Standby endpoint
# (super-scraper-api.apify.actor) -- get your token from Apify Console
# under Integrations, not from the actor page itself.
APIFY_API_TOKEN=

# Optional -- fourth/last fallback. UNCONFIRMED whether it can actually
# get through Regal's Cloudflare protection -- see the long comment in
# lib/proxyProviders/firecrawl.js. Cannot handle Regal's createOrder
# step at all (POST with a body), so it can never be the ONLY working
# provider for Regal even if it works for the rest.
FIRECRAWL_API_KEY=

# Optional -- fifth fallback for Regal pricing, and the strongest-fit
# architecture found so far (real method/data relay per Bright Data's
# own docs, unlike Firecrawl). Requires BOTH values -- the API key alone
# isn't enough. Get the key from Account Settings; the zone name comes
# from Proxies & Scraping Infrastructure -> your Web Unlocker zone ->
# Overview tab. Requires payment info on file to create the zone at all
# (unlike every other provider here), so this is opt-in, not assumed.
BRIGHTDATA_API_KEY=
BRIGHTDATA_ZONE=

# Optional -- fallback theater discovery when Overpass returns 0 results
# (common from hosted/datacenter IPs that Overpass silently blocks).
# Free tier: 3000 calls/day, no billing required. Sign up at
# myprojects.geoapify.com, create a project, copy the API key.
GEOAPIFY_API_KEY=

# Optional feature toggles -- default false (both pricing paths active).
# Set to "true" to pause the corresponding pricing calls.
DISABLE_REGAL_PRICING=false
DISABLE_CINEMARK_PRICING=false

# Optional -- if set, the app requires this password before use. Leave
# unset for local-only use. STRONGLY RECOMMENDED once this is hosted
# somewhere with a public URL (e.g. Railway) rather than localhost, since
# without it anyone with the URL can run searches against your API keys
# and consume your quota.
APP_PASSWORD=

# Railway sets this automatically -- do not set manually when deploying
# there. Only relevant for local dev if you want a non-default port.
PORT=3000
